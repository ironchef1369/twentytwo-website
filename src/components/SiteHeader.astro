---
const links = [
  { href: "/our-story/", label: "Our story" },
  { href: "/the-culture/", label: "The culture" },
  { href: "/our-coaches/", label: "Our coaches" },
  { href: "/our-home/", label: "Our home" },
  { href: "/parent-guidelines/", label: "Parent Guidelines" },
  { href: "/updates/", label: "Updates" },
];
---

<div class="topbar">
  <a href="/updates/2026-27-youth-tryouts/">2026–27 YOUTH TRYOUTS <span>→</span> VIEW UPDATE</a>
  <button aria-label="Dismiss">×</button>
</div>

<header class="site-header">
  <a class="brand" href="/" aria-label="Team TwentyTwo home">
    <img class="main-wordmark" src="/assets/twentytwo-wordmark-primary.png" alt="Team TwentyTwo">
  </a>
  <nav class="desktop-nav" id="primary-nav" aria-label="Primary navigation">
    {links.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname.replace(/\/$/, "") === href.replace(/\/$/, "") ? "page" : undefined}>{label}</a>)}
  </nav>
  <div class="header-actions">
    <a class="nav-cta" href="/tryouts/" aria-current={Astro.url.pathname.replace(/\/$/, "") === "/tryouts" ? "page" : undefined}>Tryouts</a>
    <button class="menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">☰</button>
  </div>
</header>
