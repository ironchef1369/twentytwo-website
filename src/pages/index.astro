---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const now = new Date();
const latestUpdate = (await getCollection("updates"))
  .filter((entry) =>
    entry.data.publishedAt <= now &&
    (!entry.data.expiresAt || entry.data.expiresAt >= now)
  )
  .sort((a, b) => Number(b.data.homepagePinned) - Number(a.data.homepagePinned) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];
const latestDate = latestUpdate?.data.publishedAt.toLocaleDateString("en-US", {
  month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
});
---

<BaseLayout>
  <main id="top">
    <section class="hero">
      <picture class="hero-photo">
        <source media="(max-width: 600px)" srcset="/assets/hero-team-celebration-mobile.webp" />
        <img src="/assets/hero-team-celebration-1920.webp" srcset="/assets/hero-team-celebration-1920.webp 1920w, /assets/hero-team-celebration-2560.webp 2560w" sizes="100vw" width="1920" height="1280" alt="Team TwentyTwo players and coaches celebrating together on the court" fetchpriority="high" />
      </picture>
      <div class="hero-shade"></div>
      <div class="hero-inner shell">
        <div class="hero-copy">
          <div class="eyebrow">Orange County Club Basketball <span>/</span> 8U–14U</div>
          <h1>BUILD THE<br><em>PLAYER.</em><br>NOT THE HYPE.</h1>
          <p>We develop basketball players for where they're going,<br>not just where they are today.</p>
          <p class="detail">Skills. IQ. Athletic development. Character. Competition.<br>A complete basketball environment built for the long game.</p>
          <div class="actions">
            <a class="button red" href="/the-culture/">Explore our development path <span>→</span></a>
            <a class="button outline" href="/tryouts/">Explore tryouts</a>
          </div>
        </div>
      </div>
      <img class="hero-script-logo" src="/assets/logo-script.webp" alt="Twenty2 script logo">
      <div class="hero-culture">WE ARE<br>THE CULTURE.</div>
      <div class="hero-rail"><span>01</span><i></i><small>H2</small></div>
    </section>

    <section class="affiliations" aria-labelledby="affiliations-heading">
      <div class="shell affiliations-inner">
        <div class="affiliations-intro">
          <div class="kicker red-text">/ AFFILIATIONS</div>
          <h2 id="affiliations-heading">CONNECTED TO<br>THE GAME'S BEST.</h2>
        </div>
        <div class="affiliation-logos">
          <div class="affiliation affiliation-sports-academy">
            <img src="/assets/affiliations/sports-academy.webp" alt="Sports Academy">
            <span>Affiliate program</span>
          </div>
          <div class="affiliation affiliation-nike">
            <img src="/assets/affiliations/nike-swoosh.webp" alt="Nike">
            <span>Nike program</span>
          </div>
          <div class="affiliation affiliation-eybl">
            <img src="/assets/affiliations/nike-eybl.png" alt="Nike EYBL">
            <span>Nike EYBL</span>
          </div>
        </div>
      </div>
    </section>

    {latestUpdate && <section class="latest-update light" id="updates" aria-labelledby="latest-update-heading">
      <div class="shell">
        <div class="latest-update-head">
          <div class="kicker">/ LATEST AT TWENTYTWO</div>
          <a class="update-link" href="/updates/">View all updates →</a>
        </div>
        <article class:list={["latest-update-grid", { "latest-update-no-image": !latestUpdate.data.image }]}>
          {latestUpdate.data.image && <a class="latest-update-photo" href={`/updates/${latestUpdate.id}/`} aria-label={`Read ${latestUpdate.data.title}`}>
            <img src={latestUpdate.data.image} alt={latestUpdate.data.imageAlt ?? ""} loading="lazy" width="960" height="640" />
          </a>}
          <div class="latest-update-copy">
            <div class="update-meta"><span>{latestUpdate.data.category}</span><time datetime={latestUpdate.data.publishedAt.toISOString()}>{latestDate}</time></div>
            <h2 class="section-heading" id="latest-update-heading"><a href={`/updates/${latestUpdate.id}/`}>{latestUpdate.data.title}</a></h2>
            <p>{latestUpdate.data.summary}</p>
            <a class="button red" href={`/updates/${latestUpdate.id}/`}>Read the update <span>→</span></a>
          </div>
        </article>
      </div>
    </section>}

    <section class="why light" id="about">
      <div class="shell why-grid">
        <div class="why-content">
          <div class="kicker">/ A DIFFERENT APPROACH</div>
          <h2>A BASKETBALL<br>CAREER IS BIGGER<br>THAN ONE SEASON.</h2>
          <div class="why-copy">
            <p>Every player has a different starting point and a different goal. We help them build the skills, habits, and understanding to keep growing through each stage of the game.</p>
            <strong>THE GOAL ISN'T TO PEAK EARLY.<br>THE GOAL IS TO KEEP GETTING BETTER.</strong>
          </div>
        </div>
        <div class="why-art" aria-hidden="true">
          <img class="why-mark" src="/assets/22-outline.svg" alt="">
          <img class="why-player" src="/assets/why-player-red-cutout.png" alt="">
          <div class="side-note">SAME.<br>GAME.<br><span>A BRIGHTER</span><br>TOMORROW.</div>
        </div>
      </div>
    </section>

    <section class="system dark" id="development">
      <div class="shell">
        <div class="system-head">
          <div>
            <div class="kicker red-text">/ THE TWENTYTWO WAY</div>
            <h2>DEVELOPMENT ON<br>AND OFF THE COURT.</h2>
          </div>
          <p>Purposeful coaching. Competitive basketball. A family that supports players as they work toward their goals on and off the court.</p>
        </div>
        <div class="pillars">
          <article>
            <div class="pillar-top"><span>01</span><b>◉</b></div>
            <h3>BASKETBALL<br>DEVELOPMENT</h3>
            <p>Build the fundamentals, basketball IQ, and confidence to make better decisions and contribute to the team.</p>
          </article>
          <article>
            <div class="pillar-top"><span>02</span><b>⇄</b></div>
            <h3>ATHLETIC<br>DEVELOPMENT</h3>
            <p>Develop movement, strength, and speed that support a player’s growth and preparation for the game.</p>
          </article>
          <article>
            <div class="pillar-top"><span>03</span><b>♜</b></div>
            <h3>COMPETITION</h3>
            <p>Compete with purpose. Learn to prepare, respond to challenges, and support your teammates through every game.</p>
          </article>
          <article>
            <div class="pillar-top"><span>04</span><b>◎</b></div>
            <h3>CHARACTER</h3>
            <p>Show up prepared. Listen. Take responsibility. Treat people with respect. Build habits that carry into school and life.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="journey light" id="teams">
      <div class="shell journey-grid">
        <div class="journey-title">
          <div class="journey-kicker-row"><div class="kicker">/ PLAYER JOURNEY</div><img class="journey-mark" src="/assets/logo-script.webp" alt="" aria-hidden="true"></div>
          <h2>ONE PROGRAM.<br>A LONGER JOURNEY.</h2>
        </div>
        <p class="journey-intro">From learning the fundamentals to taking on new challenges, we help players find opportunities that support their development. Trust the process and enjoy the journey.</p>
        <div class="path">
          <article><span>01</span><h3>FOUNDATION</h3><p>Love the game.<br>Learn to play.</p></article>
          <i>→</i>
          <article><span>02</span><h3>DEVELOPMENT</h3><p>Skill. IQ. Movement.<br>Confidence.</p></article>
          <i>→</i>
          <article><span>03</span><h3>COMPETITION</h3><p>Apply skills against<br>better athletes and<br>faster decisions.</p></article>
          <i>→</i>
          <article><span>04</span><h3>PREPARATION</h3><p>Build habits for the<br>next challenge, on<br>and off the court.</p></article>
        </div>
      </div>
    </section>

    <section class="facility dark" id="facility">
      <div class="facility-photo"></div>
      <div class="facility-panel">
        <div class="kicker red-text">/ HOME COURT</div>
        <h2>OUR HOME COURT.<br><em>YOUR PLACE TO GROW.</em></h2>
        <p>TwentyTwo trains inside OC Hoop Legends, a dedicated basketball environment in Lake Forest built around player development.</p>
        <a class="button red" href="/our-home/">Explore our home <span>→</span></a>
        <div class="facility-features">
          <span>◉ NBA-STYLE HARDWOOD</span>
          <span>◉ VIDEO CAPABILITY</span>
          <span>◉ CLIMATE CONTROLLED</span>
          <span>◉ STRENGTH + CONDITIONING NEXT DOOR</span>
          <span>◉ DR. DISH TRAINING</span>
          <span>◉ SPACE BUILT FOR BASKETBALL</span>
        </div>
      </div>
    </section>

    <section class="coaches light" id="coaches">
      <div class="shell">
        <div class="coaches-head">
          <div>
            <div class="kicker">/ PROGRAM OWNERS</div>
            <h2>EXPERIENCE IN THE GAME.<br>INVESTED IN<br>YOUR PLAYER.</h2>
          </div>
          <div class="coach-copy">
            <p>Founded by former Division I players Coach Brandon Holmes and Coach Jennifer Holmes, Team 22 brings years of playing, coaching, and teaching experience to young athletes in Orange County.</p>
            <a href="/our-coaches/">Meet our coaches →</a>
          </div>
        </div>
        <div class="coach-grid">
          <article class="coach-card owner-card"><img src="/assets/brandon-holmes-headshot.webp" alt="Brandon Holmes" width="800" height="800" loading="lazy" /><div><h3>BRANDON HOLMES</h3><p>Program Owner · Coach B</p></div></article>
          <article class="coach-card owner-card"><img src="/assets/jennifer-holmes-headshot.webp" alt="Jennifer Holmes" width="800" height="800" loading="lazy" /><div><h3>JENNIFER HOLMES</h3><p>Program Owner · Coach Jenn</p></div></article>
        </div>
      </div>
    </section>

    <section class="culture" id="culture">
      <div class="culture-photo"></div>
      <div class="culture-wash"></div>
      <div class="shell culture-grid">
        <div class="culture-copy">
          <div class="culture-kicker-row"><div class="kicker white">/ CULTURE</div><img class="culture-oval-logo" src="/assets/logo-oval.webp" alt="" aria-hidden="true"></div>
          <h2>WE ARE<br>THE CULTURE.</h2>
          <p>Our culture grows through everyday actions: showing up prepared, listening to coaches, encouraging teammates, and treating people with respect.</p>
          <p>TwentyTwo is competitive basketball in a family-oriented environment. We help players grow as student-athletes, take pride in their team, and enjoy the journey together.</p>
          <a class="button outline compact" href="/our-story/">Our story →</a>
        </div>
        <div class="culture-values">
          <span>HOW WE PRACTICE.</span>
          <span>HOW WE COACH.</span>
          <span>HOW WE COMPETE.</span>
          <span>HOW WE TREAT EACH OTHER.</span>
          <i></i>
        </div>
      </div>
    </section>

    <section class="social-proof" aria-labelledby="social-proof-heading">
      <div class="shell social-proof-head">
        <div>
          <div class="kicker red-text">/ FROM THE GYM</div>
          <h2 class="section-heading" id="social-proof-heading">THE WORK.<br>THE TEAM.<br>THE MOMENTS.</h2>
        </div>
        <div class="social-proof-copy">
          <p>A look inside Team TwentyTwo—competition, development and the people building the culture every day.</p>
          <a href="https://www.instagram.com/team_2wenty2/" target="_blank" rel="noreferrer">Follow @team_2wenty2 →</a>
        </div>
      </div>
      <div class="social-grid">
        <a class="social-shot social-shot-action" href="https://www.instagram.com/b_hahr/p/DdAxy9Xm20_/" target="_blank" rel="noreferrer" aria-label="View Team TwentyTwo game action on Instagram">
          <img src="/assets/instagram/game-action.jpg" alt="Team TwentyTwo player handling the ball during a game" loading="lazy">
        </a>
        <a class="social-shot" href="https://www.instagram.com/team_2wenty2/p/DdP80b9tJgf/" target="_blank" rel="noreferrer" aria-label="View Team TwentyTwo team celebration on Instagram">
          <img src="/assets/instagram/team-celebration.jpg" alt="Team TwentyTwo players and coach celebrating together" loading="lazy">
        </a>
        <a class="social-shot" href="https://www.instagram.com/team_2wenty2/p/DdADSuWStVS/" target="_blank" rel="noreferrer" aria-label="View Team TwentyTwo travel team on Instagram">
          <img src="/assets/instagram/travel-team.jpg" alt="Team TwentyTwo travel team gathered after an event" loading="lazy">
        </a>
        <a class="social-shot" href="https://www.instagram.com/huddyg10/reel/DdVls0dKmvzLIurZHZMjzhtOywgTXGyZVRSYEM0/" target="_blank" rel="noreferrer" aria-label="View Team TwentyTwo youth team on Instagram">
          <img src="/assets/instagram/youth-team.jpg" alt="Team TwentyTwo youth players and coaches together after a game" loading="lazy">
        </a>
      </div>
    </section>

    <section class="final-cta">
      <div class="final-photo"></div>
      <div class="final-shade"></div>
      <div class="shell final-grid">
        <div class="final-copy">
          <div class="kicker red-text">YOUR NEXT SEASON STARTS HERE.</div>
          <h2>READY FOR WHAT'S NEXT?</h2>
          <p>Meet our coaches, get to know our approach, and explore the next opportunity for your player. We look forward to welcoming your family.</p>
          <div class="actions">
            <a class="button red" href="/tryouts/">Explore tryouts</a>
            <a class="button outline" href="/parent-guidelines/">For our families</a>
          </div>
        </div>
        <div class="final-brand">
          <img class="main-wordmark" src="/assets/twentytwo-wordmark-primary.png" alt="Team TwentyTwo">
          <p>ORANGE COUNTY, CA<br>Home of Team TwentyTwo<br>OC Hoop Legends · Lake Forest</p>
        </div>
      </div>
      <div class="final-script">WE ARE<br>THE CULTURE.</div>
    </section>
  </main>
</BaseLayout>
