---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import UpdateCard from "../components/UpdateCard.astro";

const now = new Date();
const updates = (await getCollection("updates"))
  .filter((entry) =>
    entry.data.featured &&
    entry.data.publishedAt <= now &&
    (!entry.data.expiresAt || entry.data.expiresAt >= now)
  )
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <main id="top">
    <section class="hero">
      <div class="hero-photo"></div>
      <video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
        <source src="/assets/hero-team22.mp4" type="video/mp4">
      </video>
      <div class="hero-shade"></div>
      <div class="hero-inner shell">
        <div class="hero-copy">
          <div class="eyebrow">Orange County Club Basketball <span>/</span> 7U–17U</div>
          <h1>BUILD THE<br><em>PLAYER.</em><br>NOT THE HYPE.</h1>
          <p>We develop basketball players for where they're going,<br>not just where they are today.</p>
          <p class="detail">Skills. IQ. Athletic development. Character. Competition.<br>A complete basketball environment built for the long game.</p>
          <div class="actions">
            <a class="button red" href="#development">Explore our development path <span>→</span></a>
            <a class="button outline" href="#tryouts">Register for tryouts</a>
          </div>
        </div>
      </div>
      <img class="hero-script-logo" src="/assets/logo-script.webp" alt="Twenty2 script logo">
      <div class="hero-culture">WE ARE<br>THE CULTURE.</div>
      <div class="hero-rail"><span>01</span><i></i><small>H2</small></div>
    </section>

    <section class="affiliations" aria-labelledby="affiliations-heading">
      <div class="shell affiliations-inner">
        <div class="affiliations-intro">
          <div class="kicker red-text">/ AFFILIATIONS</div>
          <h2 id="affiliations-heading">CONNECTED TO<br>THE GAME'S BEST.</h2>
        </div>
        <div class="affiliation-logos">
          <div class="affiliation affiliation-sports-academy">
            <img src="/assets/affiliations/sports-academy.webp" alt="Sports Academy">
            <span>Affiliate program</span>
          </div>
          <div class="affiliation affiliation-nike">
            <img src="/assets/affiliations/nike-swoosh.webp" alt="Nike">
            <span>Nike program</span>
          </div>
          <div class="affiliation affiliation-eybl">
            <img src="/assets/affiliations/nike-eybl.png" alt="Nike EYBL">
            <span>Nike EYBL</span>
          </div>
        </div>
      </div>
    </section>

    <section class="why light" id="about">
      <div class="shell why-grid">
        <div class="why-content">
          <div class="kicker">/ A DIFFERENT APPROACH</div>
          <h2>A BASKETBALL<br>CAREER IS BIGGER<br>THAN ONE SEASON.</h2>
          <div class="why-copy">
            <p>Youth basketball has become obsessed with rankings, trophies and who is ahead right now. We take a longer view. TwentyTwo develops the skills, decision-making, athleticism, discipline and confidence players need as the game gets harder — year after year.</p>
            <strong>THE GOAL ISN'T TO PEAK EARLY.<br>THE GOAL IS TO KEEP GETTING BETTER.</strong>
          </div>
        </div>
        <div class="why-art" aria-hidden="true">
          <img class="why-mark" src="/assets/22-outline.svg" alt="">
          <img class="why-player" src="/assets/why-player-cutout.png" alt="">
          <div class="side-note">SAME.<br>GAME.<br><span>A BRIGHTER</span><br>TOMORROW.</div>
        </div>
      </div>
    </section>

    <section class="system dark" id="development">
      <div class="shell">
        <div class="system-head">
          <div>
            <div class="kicker red-text">/ THE TWENTYTWO WAY</div>
            <h2>EVERYTHING A PLAYER<br>NEEDS TO DEVELOP.</h2>
          </div>
          <p>More than a team. A complete development environment designed for the next level — whatever that looks like for your player.</p>
        </div>
        <div class="pillars">
          <article>
            <div class="pillar-top"><span>01</span><b>◉</b></div>
            <h3>BASKETBALL<br>DEVELOPMENT</h3>
            <p>Fundamentals become skills.<br>Skills become reads. Reads<br>become basketball.</p>
          </article>
          <article>
            <div class="pillar-top"><span>02</span><b>⇄</b></div>
            <h3>ATHLETIC<br>DEVELOPMENT</h3>
            <p>Strength, speed, movement<br>and durability developed<br>appropriately as athletes grow.</p>
          </article>
          <article>
            <div class="pillar-top"><span>03</span><b>♜</b></div>
            <h3>COMPETITION</h3>
            <p>Games matter. Winning matters.<br>But competition is where<br>development gets tested.</p>
          </article>
          <article>
            <div class="pillar-top"><span>04</span><b>◎</b></div>
            <h3>CHARACTER</h3>
            <p>Accountability. Coachability.<br>Resilience. Team-first basketball.<br>The habits that outlast the uniform.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="journey light" id="teams">
      <div class="shell journey-grid">
        <div class="journey-title">
          <div class="journey-kicker-row"><div class="kicker">/ PLAYER JOURNEY</div><img class="journey-mark" src="/assets/logo-script.webp" alt="" aria-hidden="true"></div>
          <h2>ONE PROGRAM.<br>A LONGER JOURNEY.</h2>
        </div>
        <p class="journey-intro">Different players develop at different speeds. Our job isn't to rush the process. It's to give each athlete the environment, coaching and opportunities to keep moving forward.</p>
        <div class="path">
          <article><span>7U–10U</span><h3>FOUNDATION</h3><p>Love the game.<br>Learn to play.</p></article>
          <i>→</i>
          <article><span>10U–13U</span><h3>DEVELOPMENT</h3><p>Skill. IQ. movement.<br>confidence.</p></article>
          <i>→</i>
          <article><span>13U–15U</span><h3>COMPETITION</h3><p>Apply skills against<br>better athletes and<br>faster decisions.</p></article>
          <i>→</i>
          <article><span>15U–17U</span><h3>PREPARATION</h3><p>Prepare for high school<br>basketball and what<br>comes next.</p></article>
        </div>
      </div>
    </section>

    <section class="facility dark" id="facility">
      <div class="facility-photo"></div>
      <div class="facility-panel">
        <div class="kicker red-text">/ HOME COURT</div>
        <h2>THIS ISN'T A GYM<br>WE RENT TWICE A WEEK.<br><em>THIS IS HOME.</em></h2>
        <p>TwentyTwo trains inside OC Hoop Legends, a dedicated basketball environment in Lake Forest built around player development.</p>
        <a class="button red" href="https://ochooplegends.com" target="_blank" rel="noreferrer">Explore the facility <span>→</span></a>
        <div class="facility-features">
          <span>◉ NBA-STYLE HARDWOOD</span>
          <span>◉ VIDEO CAPABILITY</span>
          <span>◉ CLIMATE CONTROLLED</span>
          <span>◉ STRENGTH + CONDITIONING NEXT DOOR</span>
          <span>◉ DR. DISH TRAINING</span>
          <span>◉ SPACE BUILT FOR BASKETBALL</span>
        </div>
      </div>
    </section>

    <section class="coaches light" id="coaches">
      <div class="shell">
        <div class="coaches-head">
          <div>
            <div class="kicker">/ OUR COACHES</div>
            <h2>COACHING MATTERS<br>MORE THAN THE LOGO<br>ON THE JERSEY.</h2>
          </div>
          <div class="coach-copy">
            <p>Experienced coaches. Shared development standards.<br>One philosophy from the youngest player through high school.</p>
            <a href="#">Meet our coaches →</a>
          </div>
          <div class="arrows">← &nbsp; →</div>
        </div>
        <div class="coach-grid">
          <article class="coach-card coach-one"><div><h3>BRANDON HOLMES</h3><p>Program Director</p></div></article>
          <article class="coach-card coach-two"><div><h3>JENN HOLMES</h3><p>Program Director</p></div></article>
          <article class="coach-card coach-three"><div><h3>KYLE JOHNSON</h3><p>Head Coach</p></div></article>
          <article class="coach-card coach-four"><div><h3>MARCUS DAVIS</h3><p>Assistant Coach</p></div></article>
          <aside class="quote-card">“BETTER<br>PLAYERS.<br>BETTER<br>PEOPLE.”</aside>
        </div>
      </div>
    </section>

    <section class="culture">
      <div class="culture-photo"></div>
      <div class="culture-wash"></div>
      <div class="shell culture-grid">
        <div class="culture-copy">
          <div class="culture-kicker-row"><div class="kicker white">/ CULTURE</div><img class="culture-oval-logo" src="/assets/logo-oval.webp" alt="" aria-hidden="true"></div>
          <h2>WE ARE<br>THE CULTURE.</h2>
          <p>Culture isn't matching uniforms or what gets posted after a win. It's how we practice. How we coach. How we compete. How we treat each other.</p>
          <p>TwentyTwo is competitive basketball in a family-oriented environment where players are expected to work, learn, compete and become great teammates.</p>
          <a class="button outline compact" href="#about">Our story →</a>
        </div>
        <div class="culture-values">
          <span>HOW WE PRACTICE.</span>
          <span>HOW WE COACH.</span>
          <span>HOW WE COMPETE.</span>
          <span>HOW WE TREAT EACH OTHER.</span>
          <i></i>
        </div>
      </div>
    </section>

    <section class="social-proof" aria-labelledby="social-proof-heading">
      <div class="shell social-proof-head">
        <div>
          <div class="kicker red-text">/ FROM THE GYM</div>
          <h2 class="section-heading" id="social-proof-heading">THE WORK.<br>THE TEAM.<br>THE MOMENTS.</h2>
        </div>
        <div class="social-proof-copy">
          <p>A look inside Team TwentyTwo—competition, development and the people building the culture every day.</p>
          <a href="https://www.instagram.com/team_2wenty2/" target="_blank" rel="noreferrer">Follow @team_2wenty2 →</a>
        </div>
      </div>
      <div class="social-grid">
        <a class="social-shot social-shot-action" href="https://www.instagram.com/b_hahr/p/DdAxy9Xm20_/" target="_blank" rel="noreferrer" aria-label="View Team TwentyTwo game action on Instagram">
          <img src="/assets/instagram/game-action.jpg" alt="Team TwentyTwo player handling the ball during a game" loading="lazy">
        </a>
        <a class="social-shot" href="https://www.instagram.com/team_2wenty2/p/DdP80b9tJgf/" target="_blank" rel="noreferrer" aria-label="View Team TwentyTwo team celebration on Instagram">
          <img src="/assets/instagram/team-celebration.jpg" alt="Team TwentyTwo players and coach celebrating together" loading="lazy">
        </a>
        <a class="social-shot" href="https://www.instagram.com/team_2wenty2/p/DdADSuWStVS/" target="_blank" rel="noreferrer" aria-label="View Team TwentyTwo travel team on Instagram">
          <img src="/assets/instagram/travel-team.jpg" alt="Team TwentyTwo travel team gathered after an event" loading="lazy">
        </a>
        <a class="social-shot" href="https://www.instagram.com/huddyg10/reel/DdVls0dKmvzLIurZHZMjzhtOywgTXGyZVRSYEM0/" target="_blank" rel="noreferrer" aria-label="View Team TwentyTwo youth team on Instagram">
          <img src="/assets/instagram/youth-team.jpg" alt="Team TwentyTwo youth players and coaches together after a game" loading="lazy">
        </a>
      </div>
    </section>

    <section class="up-next light" id="tryouts">
      <div class="shell">
        <div class="updates-section-head">
          <div class="kicker">/ LATEST AT TWENTYTWO</div>
          <a href="/updates/">View all updates →</a>
        </div>
        <div class="next-grid">
          {updates.map((entry) => <UpdateCard entry={entry} compact />)}
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="final-photo"></div>
      <div class="final-shade"></div>
      <div class="shell final-grid">
        <div class="final-copy">
          <div class="kicker red-text">YOUR NEXT SEASON STARTS HERE.</div>
          <h2>READY FOR WHAT'S NEXT?</h2>
          <p>Come experience TwentyTwo and see how we develop players differently.</p>
          <div class="actions">
            <a class="button red" href="#">Register for a tryout</a>
            <a class="button outline" href="#">Talk to a coach</a>
          </div>
        </div>
        <div class="final-brand">
          <img class="main-wordmark" src="/assets/twentytwo-wordmark-primary.png" alt="Team TwentyTwo">
          <p>ORANGE COUNTY, CA<br>Home of Team TwentyTwo<br>OC Hoop Legends · Lake Forest</p>
        </div>
      </div>
      <div class="final-script">WE ARE<br>THE CULTURE.</div>
    </section>
  </main>
</BaseLayout>
